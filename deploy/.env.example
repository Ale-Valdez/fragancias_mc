# Copiar a .env en el servidor (nunca subir el .env real al repositorio)
COMPOSE_PROJECT_NAME=fmc-staging

# Imágenes en Docker Hub
REGISTRY_NS=tu-usuario-dockerhub
IMAGE_TAG=0.1.0

# Dominio público (con https). En pruebas ALLOW_INDEXING debe ser false.
SITE_URL=https://fragancias-mc.avilab.dev
ALLOW_INDEXING=false
# Número de WhatsApp, solo dígitos, con código de país. Vacío oculta "Consultar por WhatsApp".
# WHATSAPP_PHONE=

# Túnel de Cloudflare (Zero Trust > Networks > Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=

# Base de datos
POSTGRES_USER=fmc
POSTGRES_PASSWORD=
POSTGRES_DB=fmc

# Generar con: openssl rand -hex 32
SESSION_SECRET=

# Solo para `docker compose --profile tools run --rm create-admin`.
# Se pueden pasar con -e y no hace falta guardarlos acá.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Almacenamiento S3 (el servidor interno usa estas mismas claves)
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Para migrar a AWS S3/R2: S3_ENDPOINT=, S3_REGION=, S3_FORCE_PATH_STYLE=