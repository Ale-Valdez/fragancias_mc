{
    "name": "@fmc/api",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch --env-file=../../.env src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
        "import:legacy": "tsx --env-file=../../.env src/scripts/import-legacy.ts",
        "admin:create": "tsx --env-file=../../.env src/scripts/create-admin.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1161.0",
        "@fmc/shared": "workspace:*",
        "argon2": "^0.45.1",
        "cookie-parser": "^1.4.7",
        "csv-parse": "^7.0.3",
        "drizzle-orm": "^0.45.4",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.3",
        "helmet": "^8.3.0",
        "multer": "^2.5.0",
        "pg": "^8.23.1",
        "pino": "^10.4.0",
        "puppeteer-core": "^25.16.0",
        "sharp": "^0.35.5",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.6",
        "@types/multer": "^2.3.0",
        "@types/node": "^24.19.2",
        "@types/pg": "^8.23.1",
        "drizzle-kit": "^0.31.11",
        "tsx": "^4.23.15",
        "typescript": "~5.9.3"
    }
}