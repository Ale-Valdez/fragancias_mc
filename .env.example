# ---- Desarrollo local (copiar a .env) ----
# Estas URLs son para procesos en el host (psql, consola, pnpm dev fuera de Docker).
# compose.dev.yml las reemplaza dentro de api/web: db, storage y web.
NODE_ENV=development
PORT=4000
SITE_URL=http://localhost:3000
ALLOW_INDEXING=false
# Número de WhatsApp, solo dígitos, con código de país. Vacío oculta "Consultar por WhatsApp".
# WHATSAPP_PHONE=
SESSION_SECRET=cambia-esto-por-un-texto-largo-aleatorio-de-32-o-mas

DATABASE_URL=postgres://fmc:fmc_dev_password@localhost:5440/fmc

S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_ACCESS_KEY=fmcdevaccess
S3_SECRET_KEY=fmcdevsecret123
S3_FORCE_PATH_STYLE=true
S3_BUCKET_MEDIA=media
S3_BUCKET_PRIVATE=private

PRINT_BASE_URL=http://localhost:3000

# Solo para `pnpm admin:create`. No hace falta dejarlos en el .env.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=