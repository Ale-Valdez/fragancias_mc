{
    "name": "fragancias-mc",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "pnpm -r --parallel --filter @fmc/shared --filter @fmc/api --filter @fmc/web dev",
        "build": "pnpm -r build",
        "typecheck": "pnpm -r typecheck",
        "format": "prettier --write .",
        "db:generate": "pnpm --filter @fmc/api db:generate",
        "db:migrate": "pnpm --filter @fmc/api db:migrate",
        "admin:create": "pnpm --filter @fmc/api admin:create"
    },
    "devDependencies": {
        "prettier": "^3.9.10",
        "typescript": "~5.9.3"
    },
    "packageManager": "pnpm@12.16.1"
}